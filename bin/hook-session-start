#!/usr/bin/env bash
# agentSpawn フック: セッション開始時に現在の作業状態をコンテキストへ注入する。
#   標準出力がそのままモデルに渡る。
set -uo pipefail

# 環境依存の設定(作業ログの置き場所など)。
# source すると設定ファイルの中身がそのまま実行されてしまうので、
# 必要なキーだけを読み取って値として扱う
read_kit_env() {
  local key="$1" file="$HOME/.kiro/kit.env" line
  [[ -f "$file" ]] || return 0
  line="$(grep -m1 "^[[:space:]]*${key}=" "$file" 2>/dev/null)" || return 0
  line="${line#*=}"
  line="${line%\"}"; line="${line#\"}"
  line="${line%\'}"; line="${line#\'}"
  printf '%s' "$line"
}
LOG_DIR="$(read_kit_env KIRO_WORK_LOG_DIR)"

echo "## セッション開始時の状態 (自動取得)"
echo
echo "### 作業ツリー"
echo '```'
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "branch: $(git branch --show-current 2>/dev/null)"
  git status --short 2>/dev/null | head -20
  echo "--- 直近のコミット ---"
  git log --oneline -5 2>/dev/null
else
  echo "(gitリポジトリ外: $(pwd))"
fi
echo '```'

if [[ -n "$LOG_DIR" && -d "$LOG_DIR" ]]; then
  echo
  echo "### 直近の作業ログ (${LOG_DIR})"
  echo '```'
  ls -t "$LOG_DIR" 2>/dev/null | head -5
  echo '```'
  echo "続きから始めるなら中身を read すること。"
fi

# 記憶が増えてきたら棚卸しを促す。閾値未満のときは何も言わない(毎回出すとノイズになる)
MEM_DIR="$HOME/.kiro/memory"
GC_THRESHOLD="${KIRO_MEMORY_GC_THRESHOLD:-50}"
if [[ -d "$MEM_DIR" ]]; then
  count=$(ls "$MEM_DIR"/*.md 2>/dev/null | wc -l | tr -d ' ')
  if [[ "$count" -ge "$GC_THRESHOLD" ]]; then
    echo
    echo "### 記憶の棚卸しどき"
    echo "記憶が ${count} 件あります(閾値 ${GC_THRESHOLD})。"
    echo "手が空いているときに \`memory-gc\` skill で棚卸しを提案してください。"
    echo "重複の統合とサマリの短縮が主な作業です。勝手に消さないこと。"
  fi
fi
exit 0
