#!/usr/bin/env bash
# 記憶に関わる依頼を検知して remember の手順を差し込む。
#   CLI (userPromptSubmit) が渡すもの:
#     stdin: {"hook_event_name":"userPromptSubmit","cwd":"...","prompt":"..."}
#     env  : USER_PROMPT, KIRO_SESSION_ID
#   IDE (PromptSubmit) は STDIN に session context の JSON を渡す(キー名は未確認)。
#   どちらでも拾えるよう、環境変数 -> "prompt" キー -> 入力全体 の順に見る。
set -uo pipefail

input="$(cat 2>/dev/null || true)"
prompt="${USER_PROMPT:-}"
[[ -n "$prompt" ]] || prompt="$(printf '%s' "$input" | sed -n 's/.*"prompt"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/p')"
[[ -n "$prompt" ]] || prompt="$input"

case "$prompt" in
  *覚え*|*記憶*|*おぼえ*|*忘れ*|*memory*|*remember*)
    echo "## 記憶の依頼を検知"
    echo
    echo "\`remember\` skill の手順に従って \`~/.kiro/bin/kiro-memory add\` で永続化すること。"
    echo "既存の記憶と重複しないか、まず下の一覧で確認し、近いものがあれば新規作成せず更新する。"
    echo
    echo "現在の記憶:"
    echo '```'
    "$HOME/.kiro/bin/kiro-memory" list 2>/dev/null | head -30
    echo '```'
    ;;
esac
exit 0
