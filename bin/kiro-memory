#!/usr/bin/env bash
# kiro-memory — kiro-cli 用の永続メモリ管理
#   1ファイル1事実を ~/.kiro/memory/ に置き、
#   1行サマリのインデックスを ~/.kiro/steering/00-memory-index.md に自動生成する。
#   インデックスは inclusion: always なので毎セッション自動でコンテキストに入り、
#   本文は knowledge base 経由でセマンティック検索できる。
set -euo pipefail

MEM_DIR="${KIRO_MEMORY_DIR:-$HOME/.kiro/memory}"
INDEX="${KIRO_MEMORY_INDEX:-$HOME/.kiro/steering/00-memory-index.md}"
# 索引に載せる project/reference の上限。0 なら無制限(既定)。
# 溢れた分は FULL_INDEX に全件書き出し、grep で引けるようにする。
# feedback/user は件数が少なく重要度が高いので常に全件載せる。
INDEX_MAX="${KIRO_MEMORY_INDEX_MAX:-0}"
FULL_INDEX="${KIRO_MEMORY_FULL_INDEX:-$HOME/.kiro/memory-index-full.md}"
mkdir -p "$MEM_DIR" "$(dirname "$INDEX")"

usage() {
  cat <<'USAGE'
kiro-memory <command>

  add <slug> <type> <description>   標準入力から本文を読んでメモリを作成/更新
  show <slug>                       本文を表示
  list                              一覧（slug / type / description）
  rm <slug>                         削除
  index                             steering インデックスを再生成
  doctor [--stale-days N]           棚卸しの材料を洗い出す(重複候補・古い記憶・冗長なサマリ)
  path                              メモリディレクトリのパスを表示

type: user | feedback | project | reference

例:
  echo '本文' | kiro-memory add stg-network project 'stgはHFdev/VPN必須'
USAGE
}

# frontmatter から 1 フィールドを取り出す
fm_get() {
  awk -v key="$2" '
    NR==1 && $0=="---" { inside=1; next }
    inside && $0=="---" { exit }
    inside {
      k=$0; sub(/:.*/,"",k); gsub(/^[ \t]+|[ \t]+$/,"",k)
      if (k==key) { v=$0; sub(/^[^:]*:[ \t]*/,"",v); gsub(/^"|"$/,"",v); print v; exit }
    }' "$1"
}

cmd_add() {
  local slug="${1:?slug required}" type="${2:?type required}"; shift 2
  local desc="$*"
  [[ -n "$desc" ]] || { echo "description required" >&2; exit 1; }
  case "$type" in user|feedback|project|reference) ;; *) echo "invalid type: $type" >&2; exit 1;; esac
  local body; body="$(cat)"
  [[ -n "$body" ]] || { echo "body required on stdin" >&2; exit 1; }
  local f="$MEM_DIR/$slug.md"
  local created; created="$(date +%F)"
  [[ -f "$f" ]] && created="$(fm_get "$f" created || true)"
  [[ -n "$created" ]] || created="$(date +%F)"
  {
    printf -- '---\n'
    printf 'name: %s\n' "$slug"
    printf 'description: %s\n' "$desc"
    printf 'type: %s\n' "$type"
    printf 'created: %s\n' "$created"
    printf 'updated: %s\n' "$(date +%F)"
    printf -- '---\n\n'
    printf '%s\n' "$body"
  } > "$f"
  cmd_index
  echo "saved: $f"
}

cmd_index() {
  local tmp; tmp="$(mktemp)"
  {
    printf -- '---\n'
    printf 'inclusion: always\n'
    printf -- '---\n\n'
    printf '# 記憶(memory index)\n\n'
    printf 'これは過去セッションから引き継いだ事実の索引。各行は `~/.kiro/memory/<name>.md` の要約。\n'
    printf '詳細が要るときは knowledge ツールで検索するか、該当ファイルを read すること。\n'
    printf '新しく覚えるべき事実が出たら `remember` skill の手順で追記する(勝手に忘れない)。\n\n'
  } > "$tmp"

  # 全ファイルの frontmatter を awk 1回で読む。
  # ファイル数ぶんプロセスを起動すると数百件で数秒かかるため、まとめて処理する
  local body=""
  if compgen -G "$MEM_DIR/*.md" >/dev/null; then
    body="$(awk '
      FNR==1 { fm=0; n=""; d=""; t=""; u=""; done=0
               slug=FILENAME; sub(/.*\//,"",slug); sub(/\.md$/,"",slug) }
      done { next }
      FNR==1 && $0=="---" { fm=1; next }
      fm && $0=="---" {
        fm=0; done=1
        if (n=="") n=slug
        if (t=="") t="project"
        c++; N[c]=n; D[c]=d; T[c]=t; U[c]=u
        next
      }
      fm {
        if (match($0, /^name:[ \t]*/))             n=substr($0, RLENGTH+1)
        else if (match($0, /^description:[ \t]*/)) d=substr($0, RLENGTH+1)
        else if (match($0, /^type:[ \t]*/))        t=substr($0, RLENGTH+1)
        else if (match($0, /^updated:[ \t]*/))     u=substr($0, RLENGTH+1)
      }
      END {
        # updated の降順に並べる(単純挿入ソート。件数が多くないので十分)
        for (i=2; i<=c; i++) {
          kn=N[i]; kd=D[i]; kt=T[i]; ku=U[i]; j=i-1
          while (j>=1 && U[j] < ku) { N[j+1]=N[j]; D[j+1]=D[j]; T[j+1]=T[j]; U[j+1]=U[j]; j-- }
          N[j+1]=kn; D[j+1]=kd; T[j+1]=kt; U[j+1]=ku
        }
        for (i=1; i<=c; i++) {
          line = "- `" N[i] "` — " D[i] (U[i]=="" ? "" : "  (" U[i] ")") "\n"
          full[T[i]] = full[T[i]] line
          capped = (max > 0 && (T[i]=="project" || T[i]=="reference"))
          if (capped) {
            shown[T[i]]++
            if (shown[T[i]] > max) { omitted[T[i]]++; continue }
          }
          rows[T[i]] = rows[T[i]] line
        }

        split("project feedback user reference", order, " ")
        for (i=1; i<=4; i++) {
          k=order[i]
          if (k in rows) {
            printf "## %s\n\n%s", k, rows[k]
            if (omitted[k] > 0) printf "- ...他 %d 件(古い順に省略)\n", omitted[k]
            printf "\n"
          }
          delete rows[k]
        }
        for (k in rows) printf "## %s\n\n%s\n", k, rows[k]   # 想定外の type も落とさない

        # 全件は別ファイルへ(steering ではないのでコンテキストには入らない)
        if (fullpath != "") {
          printf "# 記憶の全件索引\n\n" > fullpath
          printf "索引から省略された記憶もここには載っている。grep で探すこと。\n\n" > fullpath
          for (i=1; i<=4; i++) {
            k=order[i]
            if (k in full) printf "## %s\n\n%s\n", k, full[k] > fullpath
          }
        }
      }
    ' max="$INDEX_MAX" fullpath="$FULL_INDEX" "$MEM_DIR"/*.md)"
  fi

  if [[ -n "$body" ]]; then
    printf '%s\n' "$body" >> "$tmp"
  else
    printf '(まだ記憶がありません)\n' >> "$tmp"
  fi
  mv "$tmp" "$INDEX"
  echo "index: $INDEX"
}

# 棚卸しの材料を機械的に洗い出す。判断も削除もしない — 出すだけ。
# 何を統合し何を消すかは memory-gc skill 側でモデルが決め、必ず人に確認する。
cmd_doctor() {
  local stale_days=180
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stale-days) stale_days="${2:?days required}"; shift 2 ;;
      *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
  done
  compgen -G "$MEM_DIR/*.md" >/dev/null || { echo "記憶がありません"; return 0; }

  local cutoff
  if date -v-1d +%F >/dev/null 2>&1; then cutoff="$(date -v-${stale_days}d +%F)"   # BSD
  else cutoff="$(date -d "${stale_days} days ago" +%F)"; fi                        # GNU

  awk -v cutoff="$cutoff" -v days="$stale_days" '
    FNR==1 { fm=0; n=""; d=""; t=""; u=""; done=0
             slug=FILENAME; sub(/.*\//,"",slug); sub(/\.md$/,"",slug) }
    done { next }
    FNR==1 && $0=="---" { fm=1; next }
    fm && $0=="---" {
      fm=0; done=1
      if (n=="") n=slug
      c++; name[c]=n; desc[c]=d; type[c]=t; upd[c]=u
      next
    }
    fm {
      if (match($0, /^name:[ \t]*/))             n=substr($0, RLENGTH+1)
      else if (match($0, /^description:[ \t]*/)) d=substr($0, RLENGTH+1)
      else if (match($0, /^type:[ \t]*/))        t=substr($0, RLENGTH+1)
      else if (match($0, /^updated:[ \t]*/))     u=substr($0, RLENGTH+1)
    }
    END {
      printf "# 記憶の棚卸し材料 (全 %d 件)\n\n", c

      # 1. 更新が古いもの
      printf "## %d日以上更新されていない (%s 以前)\n\n", days, cutoff
      stale=0
      for (i=1; i<=c; i++) if (upd[i] != "" && upd[i] < cutoff) {
        printf "- `%s` (%s) — %s\n", name[i], upd[i], desc[i]; stale++
      }
      if (!stale) print "(なし)"
      print ""

      # 2. 重複候補: slug のトークンが2語以上一致
      print "## 重複候補 (slug のトークンが2語以上共通)"
      print ""
      dup=0
      for (i=1; i<=c; i++) {
        ni=split(name[i], ti, "-")
        for (j=i+1; j<=c; j++) {
          nj=split(name[j], tj, "-"); shared=0
          for (a=1; a<=ni; a++) for (b=1; b<=nj; b++)
            if (length(ti[a])>2 && ti[a]==tj[b]) shared++
          if (shared >= 2) { printf "- `%s` <-> `%s`\n", name[i], name[j]; dup++ }
        }
      }
      if (!dup) print "(なし)"
      print ""

      # 3. サマリが長いもの(索引を圧迫する)
      print "## description が長い (80文字超)"
      print ""
      lng=0
      for (i=1; i<=c; i++) {
        L=length(desc[i])
        if (L > 80) { printf "- `%s` (%d文字)\n", name[i], L; lng++ }
      }
      if (!lng) print "(なし)"
      print ""

      printf "## 内訳\n\n"
      for (i=1; i<=c; i++) cnt[type[i]]++
      for (k in cnt) printf "- %s: %d件\n", k, cnt[k]
    }
  ' "$MEM_DIR"/*.md
}

cmd_list() {
  local f
  for f in "$MEM_DIR"/*.md; do
    [[ -e "$f" ]] || { echo "(empty)"; return; }
    printf '%-28s %-10s %s\n' "$(fm_get "$f" name)" "$(fm_get "$f" type)" "$(fm_get "$f" description)"
  done
}

case "${1:-}" in
  add)   shift; cmd_add "$@" ;;
  show)  shift; cat "$MEM_DIR/${1:?slug required}.md" ;;
  list)  cmd_list ;;
  rm)    shift; rm -f "$MEM_DIR/${1:?slug required}.md"; cmd_index ;;
  index) cmd_index ;;
  doctor) shift; cmd_doctor "$@" ;;
  path)  echo "$MEM_DIR" ;;
  *)     usage; exit 1 ;;
esac
